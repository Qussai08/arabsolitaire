{
  "name": "arabsolitaire-firebase",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix functions",
    "emulators": "node scripts/start-emulators.mjs",
    "emulators:full": "npm run build && firebase emulators:start",
    "emulators:lite": "npm run build && firebase emulators:start --only functions,auth",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "npm run build && firebase emulators:start --import=./emulator-data",
    "rules:test": "mocha --timeout 60000 rules/test/firestore_rules_test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.28.1",
    "mocha": "^11.7.1"
  }
}
